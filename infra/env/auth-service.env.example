DATABASE_URL=postgresql://auth_user:<AUTH_DB_PASSWORD>@postgres:5432/auth_db
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672
JWT_KID=toka-key-1
ACCESS_TOKEN_TTL_SECONDS=900
COOKIE_SECURE=true
SVC_CLIENT_ID=auth-service
SVC_CLIENT_SECRET=<change-me>
PORT=3001
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_ISSUER=toka-auth
REFRESH_TOKEN_TTL_SECONDS=604800
SERVICE_TOKEN_TTL_SECONDS=300
# Comma-separated id:secret pairs allowed on POST /oauth/token (user-service secret must match its own env)
SERVICE_CLIENTS=user-service:<USER_SERVICE_CLIENT_SECRET>
RETRY_DELAYS_MS=5000,30000,120000
MAX_RETRIES=3
PUBLISH_RETRIES=3
LOG_LEVEL=info
