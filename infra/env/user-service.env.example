PORT=3002
DATABASE_URL=postgresql://user_user:<USER_DB_PASSWORD>@postgres:5432/user_db
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672
JWKS_URI=http://auth-service:3001/.well-known/jwks.json
AUTH_BASE_URL=http://auth-service:3001
ROLE_BASE_URL=http://role-service:3003
SVC_CLIENT_ID=user-service
SVC_CLIENT_SECRET=<change-me>
ROLE_TIMEOUT_MS=2000
AUTH_TIMEOUT_MS=3000
SIGNUP_BUDGET_MS=10000
RECONCILE_GRACE_MS=60000
RECONCILE_INTERVAL_MS=30000
OUTBOX_POLL_MS=1000
OUTBOX_BATCH=50
ADMIN_SEED_EMAIL=<admin-email>
ADMIN_SEED_PASSWORD=<admin-password>
ADMIN_SEED_ROLE_ID=00000000-0000-4000-8000-000000000001
