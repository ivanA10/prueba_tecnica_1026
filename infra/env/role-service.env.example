DATABASE_URL=postgresql://role_user:<ROLE_DB_PASSWORD>@postgres:5432/role_db
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672
PORT=3003
AUTH_JWKS_URL=http://auth-service:3001/.well-known/jwks.json
JWT_ISSUER=toka-auth
ROLE_CACHE_TTL_SECONDS=300
ADMIN_ROLE_ID=00000000-0000-4000-8000-000000000001
OPERADOR_ROLE_ID=00000000-0000-4000-8000-000000000002
AUDITOR_ROLE_ID=00000000-0000-4000-8000-000000000003
PUBLISH_RETRIES=3
LOG_LEVEL=info
