PORT=3005
JWT_ISSUER=toka-auth
JWT_AUDIENCE=toka-api
JWKS_URI=http://auth-service:3001/.well-known/jwks.json
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
QDRANT_URL=http://qdrant:6333
USER_SERVICE_URL=http://user-service:3002
# Empty ANTHROPIC_API_KEY => deterministic mock provider. LLM_MODEL is required when a key is set.
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000
LLM_MAX_CONCURRENCY=4
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_RESET_MS=30000
# Prices per million tokens; empty => cost reported as null / n/d
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
AGENT_DEADLINE_MS=30000
USER_TOOL_TIMEOUT_MS=3000
AGENT_RL_MAX=20
AGENT_RL_WINDOW_S=60
AGENT_ADMIN_ROLE=admin
AGENT_SEED_ON_START=true
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP_TOKENS=32
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
INGEST_MAX_CHARS=50000
EMBEDDING_MODEL_DIR=/app/apps/ai-agent-service/models
KNOWLEDGE_DIR=/app/apps/ai-agent-service/knowledge
