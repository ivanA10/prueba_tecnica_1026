{
  "name": "toka",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:test-deps": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter @toka/auth-service --filter @toka/role-service --filter @toka/user-service prisma:generate",
    "test:unit": "pnpm run build:test-deps && pnpm -r --filter \"!@toka/e2e\" test -- --coverage",
    "test": "pnpm run test:unit",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"*.{js,mjs,json,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
