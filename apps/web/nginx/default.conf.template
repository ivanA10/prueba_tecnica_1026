limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 64k;
    resolver 127.0.0.11 valid=10s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location ^~ /internal/ { return 404; }
    location ^~ /oauth/ { return 404; }

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        set $auth_up ${AUTH_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$auth_up;
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location ^~ /api/auth/ {
        set $auth_up ${AUTH_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$auth_up;
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location ^~ /api/users {
        set $user_up ${USER_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$user_up;
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location ^~ /api/roles {
        set $role_up ${ROLE_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$role_up;
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location ^~ /api/audit {
        set $audit_up ${AUDIT_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$audit_up;
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location ^~ /api/agent/ {
        set $agent_up ${AGENT_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$agent_up;
        proxy_read_timeout 40s;
        client_max_body_size 1m;
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location ^~ /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
