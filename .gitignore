# Dependencies
node_modules/

# Build output
dist/
build/

# Coverage (root and nested packages), but keep docs/coverage/
coverage/
!docs/coverage/

# Environment and secrets
.env
.env.*
!.env.example

# Logs and OS files
*.log
.DS_Store

# Tool caches
.turbo/
.vite/
.cache/

# ML model caches
models/

# SDD / harness runtime state
.claude/state/
.sdd/

# Per-service env files and generated secrets (templates stay versioned)
infra/env/*.env
!infra/env/*.env.example
secrets/

# Engram memory export: kept local, not versioned
.engram/

# Generated code
apps/*/src/generated/
apps/web/dist/
