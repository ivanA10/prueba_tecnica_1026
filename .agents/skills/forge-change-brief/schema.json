{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeBrief",
  "type": "object",
  "required": ["what", "why", "where", "existing", "contracts", "proof", "release_revert"],
  "additionalProperties": false,
  "properties": {
    "what": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280,
      "description": "Qué se cambia. Frase concreta, no genérica."
    },
    "why": {
      "type": "object",
      "required": ["reason", "tag"],
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string", "minLength": 10 },
        "tag": { "enum": ["bug", "feature", "refactor", "perf", "security", "compliance"] }
      }
    },
    "where": {
      "type": "object",
      "required": ["paths", "module"],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "module": { "type": "string", "minLength": 1 }
      }
    },
    "existing": {
      "type": "object",
      "required": ["explored", "findings"],
      "additionalProperties": false,
      "properties": {
        "explored": { "type": "boolean", "const": true },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim", "evidence"],
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string", "minLength": 5 },
              "evidence": {
                "type": "string",
                "pattern": "^(file:|engram:|url:).+"
              }
            }
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["stable_list"],
      "additionalProperties": false,
      "properties": {
        "stable_list": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "APIs/schemas/interfaces que NO deben cambiar. Vacío = explícitamente sin contratos estables."
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["test_types", "test_files"],
      "additionalProperties": false,
      "properties": {
        "test_types": {
          "type": "array",
          "items": { "enum": ["unit", "integration", "e2e", "contract", "manual"] },
          "minItems": 1
        },
        "test_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "release_revert": {
      "type": "object",
      "required": ["strategy", "rollback"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["direct", "feature-flag", "migration", "blue-green", "canary"] },
        "rollback": { "type": "string", "minLength": 10 }
      }
    }
  }
}
